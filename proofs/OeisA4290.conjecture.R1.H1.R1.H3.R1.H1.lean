-- H1 := ∀ k n : ℕ, k ≤ 4 → 0 < n → n < 10 ^ k - 1 →     ∃ m < (10 ^ (9 * k) - 1) / 9,       0 < m ∧ n ∣ m ∧ ∀ d ∈ Nat.digits 10 m, d = 0 ∨ d = 1  /-- All `n < 10^5 - 1` coprime to `10`. -/

namespace OMAA4290

def dec : ℕ → ℕ → ℕ
  | 0, _ => 0
  | f + 1, w => w % 2 + 10 * dec f (w / 2)

theorem dec_digits (f : ℕ) : ∀ w, ∀ d ∈ Nat.digits 10 (dec f w), d = 0 ∨ d = 1 := by
  induction f with
  | zero => intro w d hd; simp [dec] at hd
  | succ f ih =>
    intro w d hd
    simp only [dec] at hd
    by_cases h0 : w % 2 = 0 ∧ dec f (w / 2) = 0
    · rw [h0.1, h0.2] at hd; simp at hd
    · rw [Nat.digits_add 10 (by norm_num) _ _ (by omega) (by omega)] at hd
      rcases List.mem_cons.1 hd with h | h
      · omega
      · exact ih _ d h

def ok (n w : ℕ) : Bool :=
  decide (0 < dec 31 w ∧ dec 31 w % n = 0 ∧
    ∀ k < 5, n < 10 ^ k - 1 → dec 31 w < (10 ^ (9 * k) - 1) / 9)

def checkAll : List ℕ → ℕ → Bool
  | [], _ => true
  | w :: ws, n => ok n w && checkAll ws (n + 1)

theorem checkAll_spec : ∀ (ws : List ℕ) (n0 : ℕ), checkAll ws n0 = true →
    ∀ i < ws.length, ok (n0 + i) (ws.getD i 0) = true := by
  intro ws
  induction ws with
  | nil => intro n0 _ i hi; simp at hi
  | cons w ws ih =>
    intro n0 h i hi
    simp only [checkAll, Bool.and_eq_true] at h
    cases i with
    | zero => simpa using h.1
    | succ i =>
      have := ih (n0 + 1) h.2 i (by simpa using hi)
      simpa [Nat.add_assoc, Nat.add_comm 1 i] using this

